diff -Nru orig/CMakeLists.txt tree/CMakeLists.txt
--- orig/CMakeLists.txt	2026-07-14 13:51:03.000000000 +0200
+++ tree/CMakeLists.txt	2026-08-02 21:17:05.670029125 +0200
@@ -11,6 +11,14 @@
 set(CMAKE_CXX_STANDARD_REQUIRED YES)
 set(CMAKE_POSITION_INDEPENDENT_CODE YES)
 
+# Do not hardcode libc++; use the system default C++ runtime (e.g. libstdc++).
+foreach(_flag_var CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG CMAKE_CXX_FLAGS_RELEASE
+        CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS)
+    if(DEFINED ${_flag_var})
+        string(REPLACE "-stdlib=libc++" "" ${_flag_var} "${${_flag_var}}")
+    endif()
+endforeach()
+
 # Don't export any symbols except those explicitly exported.
 set(CMAKE_VISIBILITY_INLINES_HIDDEN YES)
 set(CMAKE_C_VISIBILITY_PRESET hidden)
